# Copy to .env to configure docker-compose.hosting.yml. Nothing here is secret.

# Public host name for the relay (the "public" profile). Needs a DNS record
# pointing at this machine, and ports 80 and 443 reachable from the internet
# so Caddy can get a certificate. Leave as "localhost" to test locally.
RELAY_HOSTNAME=relay.example.com

# Host ports. Change them if these are already used on this machine.
# RELAY_PORT=3001
# PROXY_HTTP_PORT=80
# PROXY_HTTPS_PORT=443
